import React, { useState, useEffect, useCallback } from 'react'
import { Settings, Image as ImageIcon, MessageSquare, Save, CheckCircle, Languages, Cpu, Search, Globe, Key, Activity, Server, Minus, Square, X as CloseIcon, Zap } from 'lucide-react'
import ScreenshotMask from './components/ScreenshotMask'
import ResultView from './components/ResultView'

declare global {
  interface Window {
    ipcRenderer: any
  }
}

function App() {
  const [windowType] = useState<string>(() => {
    const params = new URLSearchParams(window.location.search)
    const windowParam = params.get('window')
    if (windowParam) return windowParam

    const hash = window.location.hash
    if (hash.includes('mask')) return 'mask'
    if (hash.includes('result')) return 'result'
    return 'main'
  })
  const [activeTab, setActiveTab] = useState<'translate' | 'settings'>('translate')
  const [settings, setSettings] = useState<any>({
    vlmProvider: 'ollama',
    vlmModel: 'deepseek-ocr:3b',
    vlmApiKey: '',
    vlmBaseUrl: 'http://127.0.0.1:11434',
    vlmTranslatePrompt: 'Translate the text in the image to natural, fluent Chinese. Output ONLY the translated text, nothing else.',
    vlmExplainPrompt: 'Analyze the image and explain the content in detail in Chinese. Output ONLY the explanation, nothing else.',
    mode: 'VLM',
    ocrProvider: 'ollama',  // Fixed: changed from 'local' to 'ollama'
    ocrApiKey: '',
    ocrBaseUrl: 'http://127.0.0.1:11434',
    ocrModel: 'deepseek-ocr:3b',
    llmProvider: 'ollama',
    llmModel: 'rnj-1:8b-instruct-q8_0',
    llmApiKey: '',
    llmBaseUrl: 'http://127.0.0.1:11434',
    llmTranslatePrompt: 'Translate the following text to Chinese. Output ONLY the translation, nothing else.',
    llmExplainPrompt: 'Explain the following text in detail in Chinese. Output ONLY the explanation, nothing else.',
    enableTextSelection: false
  })
  const [saveStatus, setSaveStatus] = useState<'idle' | 'saving' | 'saved'>('idle')

  useEffect(() => {
    // If we are in a sub-window, force transparent background
    if (windowType !== 'main') {
      document.body.style.background = 'transparent'
      document.documentElement.style.background = 'transparent'
    }

    window.ipcRenderer.getSettings().then((res: any) => {
      if (res) setSettings(res)
    })
  }, [windowType])

  const handleCapture = async (region: { x: number; y: number; width: number; height: number }, mode: 'translate' | 'explain') => {
    console.log(`[App] handleCapture called - Mode: ${mode}, Region:`, region)
    
    // Don't close mask yet - let the main window handle everything
    // Just send the region and mode to main window
    window.ipcRenderer.send('process-screenshot', { region, mode })
    
    // Close mask after sending the event
    window.ipcRenderer.closeMask()
  }

  // This function is called by the main window to actually process the screenshot
  const processScreenshot = useCallback(async (region: { x: number; y: number; width: number; height: number }, mode: 'translate' | 'explain') => {
    // Prevent duplicate requests
    if (window.currentAbortController) {
      console.log('[App] Cancelling previous request')
      window.currentAbortController.abort()
    }

    // Create AbortController for this request
    const abortController = new AbortController()
    window.currentAbortController = abortController

    window.ipcRenderer.showResult({ x: region.x + region.width + 10, y: region.y, content: 'Processing...' })

    console.log(`[App] Starting capture - Mode: ${mode}, Pipeline: ${settings.mode}`)
    console.log(`[App] Current settings:`, {
      mode: settings.mode,
      vlmProvider: settings.vlmProvider,
      vlmModel: settings.vlmModel,
      vlmBaseUrl: settings.vlmBaseUrl,
      ocrProvider: settings.ocrProvider,
      ocrModel: settings.ocrModel,
      ocrBaseUrl: settings.ocrBaseUrl,
      llmProvider: settings.llmProvider,
      llmModel: settings.llmModel,
      llmBaseUrl: settings.llmBaseUrl
    })

    try {
      const dataUrl = await window.ipcRenderer.captureScreen()
      const img = new Image()
      img.src = dataUrl
      await new Promise(resolve => img.onload = resolve)

      const canvas = document.createElement('canvas')
      canvas.width = region.width
      canvas.height = region.height
      const ctx = canvas.getContext('2d')
      const dpr = window.devicePixelRatio || 1

      // Force round coordinates and dimensions for stability
      const drawX = Math.round(region.x * dpr)
      const drawY = Math.round(region.y * dpr)
      const drawW = Math.round(region.width * dpr)
      const drawH = Math.round(region.height * dpr)

      ctx?.drawImage(img, drawX, drawY, drawW, drawH, 0, 0, region.width, region.height)

      // Check if image is too small - qwen3-vl has issues with very small images
      const MIN_IMAGE_SIZE = 100
      let finalCanvas = canvas
      if (region.width < MIN_IMAGE_SIZE || region.height < MIN_IMAGE_SIZE) {
        console.log(`[App] Image too small (${region.width}x${region.height}), resizing to at least ${MIN_IMAGE_SIZE}px`)

        const resizedCanvas = document.createElement('canvas')
        const scale = Math.max(MIN_IMAGE_SIZE / region.width, MIN_IMAGE_SIZE / region.height)
        resizedCanvas.width = Math.round(region.width * scale)
        resizedCanvas.height = Math.round(region.height * scale)

        const resizedCtx = resizedCanvas.getContext('2d')
        resizedCtx?.drawImage(canvas, 0, 0, resizedCanvas.width, resizedCanvas.height)
        finalCanvas = resizedCanvas
      }

      const croppedBase64 = finalCanvas.toDataURL('image/jpeg', 0.9).split(',')[1]
      console.log(`[App] Image processed, final size: ${finalCanvas.width}x${finalCanvas.height}, base64 length: ${croppedBase64.length}`)

      let result = ''
      if (settings.mode === 'VLM') {
        console.log(`[App] Using VLM pipeline`)
        console.log(`[App] VLM Config:`, {
          provider: settings.vlmProvider,
          model: settings.vlmModel,
          baseUrl: settings.vlmBaseUrl
        })
        result = await window.ipcRenderer.callAI({
          provider: settings.vlmProvider,
          apiKey: settings.vlmApiKey,
          baseUrl: settings.vlmBaseUrl,
          model: settings.vlmModel
        }, {
          prompt: mode === 'translate' ? settings.vlmTranslatePrompt : settings.vlmExplainPrompt,
          images: [croppedBase64]
        })
      } else {
        // Pipe B (OCR -> LLM) flow
        console.log(`[Pipe B] Starting OCR -> LLM pipeline`)
        console.log(`[Pipe B] Mode: ${mode}`)
        console.log(`[Pipe B] OCR Config:`, {
          provider: settings.ocrProvider,
          model: settings.ocrModel,
          baseUrl: settings.ocrBaseUrl
        })
        console.log(`[Pipe B] LLM Config:`, {
          provider: settings.llmProvider,
          model: settings.llmModel,
          baseUrl: settings.llmBaseUrl
        })
        
        const ocrText = await window.ipcRenderer.callOCR({
          provider: settings.ocrProvider,
          apiKey: settings.ocrApiKey,
          baseUrl: settings.ocrBaseUrl,
          model: settings.ocrModel
        }, croppedBase64)

        console.log(`[Pipe B] OCR Result: ${ocrText}`)
        if (!ocrText || ocrText.trim().length === 0) {
          throw new Error('OCR 无法识别选区内的文字。')
        }

        console.log(`[Pipe B] Starting LLM processing...`)
        const llmPrompt = (mode === 'translate' ? settings.llmTranslatePrompt : settings.llmExplainPrompt) + "\n\n选区文字如下：\n" + ocrText
        console.log(`[Pipe B] LLM Prompt:`, llmPrompt.substring(0, 100) + '...')
        result = await window.ipcRenderer.callAI({
          baseUrl: settings.llmBaseUrl,
          model: settings.llmModel
        }, {
          prompt: llmPrompt
        })
        
        console.log(`[Pipe B] LLM Result received`)
      }

      console.log(`[App] AI Result received, length: ${result.length}`)
      window.ipcRenderer.showResult({ x: region.x + region.width + 10, y: region.y, content: result })
    } catch (error: any) {
      console.error(`[App] Error during capture:`, error)
      if (error.name === 'AbortError') {
        console.log(`[App] Request cancelled by user`)
        window.ipcRenderer.hideResult()
      } else {
        window.ipcRenderer.showResult({ x: region.x + region.width + 10, y: region.y, content: `Error: ${error.message}` })
      }
    } finally {
      // Clean up abort controller
      if (window.currentAbortController === abortController) {
        window.currentAbortController = null
      }
    }
  }, [settings])

    // Listen for process-screenshot events from mask window
  useEffect(() => {
    if (windowType === 'main') {
      const handleProcessScreenshot = (_event: any, data: { region: any, mode: any }) => {
        console.log('[App] Received process-screenshot event:', data)
        processScreenshot(data.region, data.mode)
      }
      
      window.ipcRenderer.on('process-screenshot', handleProcessScreenshot)
      
      return () => {
        window.ipcRenderer.off('process-screenshot', handleProcessScreenshot)
      }
    }
  }, [windowType])

  // Listen for cancel-requests event
  useEffect(() => {
    if (windowType === 'main') {
      const handleCancelRequests = () => {
        console.log('[App] Received cancel-requests event')
        if (window.currentAbortController) {
          window.currentAbortController.abort()
        }
      }
      
      window.ipcRenderer.on('cancel-requests', handleCancelRequests)
      
      return () => {
        window.ipcRenderer.off('cancel-requests', handleCancelRequests)
      }
    }
  }, [windowType])

  const handleSaveSettings = async () => {
    setSaveStatus('saving')
    try {
      const result = await window.ipcRenderer.saveSettings(settings)
      if (result.success) {
        setSaveStatus('saved')
        setTimeout(() => setSaveStatus('idle'), 2000)
      } else {
        console.error('Failed to save settings:', result.error)
        setSaveStatus('idle')
      }
    } catch (error: any) {
      console.error('Error saving settings:', error)
      setSaveStatus('idle')
    }
  }

  // Simple Router based on windowType query parameter
  if (windowType === 'result') return <ResultView />
  if (windowType === 'mask') return (
    <div className="w-screen h-screen bg-transparent overflow-hidden no-drag">
      <ScreenshotMask onCapture={handleCapture} onCancel={() => window.ipcRenderer.closeMask()} />
    </div>
  )

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans select-none overflow-hidden">
      <header className="h-12 border-b bg-white flex items-center justify-between px-4 drag shrink-0">
        <div className="flex items-center gap-2">
          <div className="w-6 h-6 bg-blue-600 rounded flex items-center justify-center">
            <Globe size={14} className="text-white" />
          </div>
          <h1 className="text-sm font-black bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600 tracking-tight uppercase">Vision Bridge</h1>
        </div>

        {/* Window Controls */}
        <div className="flex gap-1 no-drag ml-auto mr-4">
          <button onClick={() => window.ipcRenderer.minimizeWindow()} className="p-2 hover:bg-slate-100 rounded-lg text-slate-400 transition-colors">
            <Minus size={16} />
          </button>
          <button onClick={() => window.ipcRenderer.maximizeWindow()} className="p-2 hover:bg-slate-100 rounded-lg text-slate-400 transition-colors">
            <Square size={14} />
          </button>
          <button onClick={() => window.ipcRenderer.closeWindow()} className="p-2 hover:bg-red-50 hover:text-red-500 rounded-lg text-slate-400 transition-colors">
            <CloseIcon size={16} />
          </button>
        </div>

        <div className="flex gap-2 no-drag border-l pl-4">
          <button
            onClick={() => setActiveTab('translate')}
            className={`p-2 rounded-lg transition-all ${activeTab === 'translate' ? 'bg-blue-50 text-blue-600 shadow-sm' : 'text-slate-400 hover:bg-slate-100'}`}
          >
            <ImageIcon size={18} />
          </button>
          <button
            onClick={() => setActiveTab('settings')}
            className={`p-2 rounded-lg transition-all ${activeTab === 'settings' ? 'bg-blue-50 text-blue-600 shadow-sm' : 'text-slate-400 hover:bg-slate-100'}`}
          >
            <Settings size={18} />
          </button>
        </div>
      </header>

      <main className="flex-1 p-4 overflow-auto bg-slate-50 custom-scrollbar">
        {activeTab === 'translate' ? (
          <div className="flex flex-col items-center justify-center h-full gap-6 text-center animate-in fade-in zoom-in duration-300">
             <div className="relative">
              <div className="w-24 h-24 bg-blue-600/10 rounded-full flex items-center justify-center animate-pulse">
                <ImageIcon size={48} className="text-blue-600" />
              </div>
              <div className="absolute -bottom-1 -right-1 w-8 h-8 bg-white rounded-full shadow-lg flex items-center justify-center border border-slate-100">
                <div className="w-2 h-2 bg-green-500 rounded-full"></div>
              </div>
            </div>
            <div>
              <p className="font-bold text-lg text-slate-800 tracking-tight">Bridge Ready</p>
              <p className="text-[11px] text-slate-400 mt-1 uppercase font-bold tracking-widest">Global: Alt + A</p>
            </div>
            <button
              onClick={() => window.ipcRenderer.openMask()}
              className="px-8 py-3 bg-blue-600 text-white rounded-xl text-sm font-black shadow-xl shadow-blue-200 hover:bg-blue-700 hover:scale-105 active:scale-95 transition-all">
              CAPTURE SCREEN
            </button>
          </div>
        ) : (
          <div className="space-y-6 pb-10 animate-in fade-in slide-in-from-right-4 duration-300">
            <section className="space-y-3">
              <div className="flex items-center gap-2 px-1">
                <Activity size={12} className="text-blue-500" />
                <h2 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Pipeline Architecture</h2>
              </div>
              <div className="grid grid-cols-2 gap-2 bg-slate-200/50 p-1.5 rounded-xl border border-slate-200/50">
                <button
                  onClick={() => setSettings({...settings, mode: 'VLM'})}
                  className={`flex flex-col items-center gap-1 py-3 rounded-lg transition-all ${settings.mode === 'VLM' ? 'bg-white shadow-md text-blue-600' : 'text-slate-500 hover:bg-slate-200'}`}
                >
                  <Cpu size={14} />
                  <span className="text-[10px] font-bold">PIPE A (VL)</span>
                </button>
                <button
                  onClick={() => setSettings({...settings, mode: 'OCR+LLM'})}
                  className={`flex flex-col items-center gap-1 py-3 rounded-lg transition-all ${settings.mode === 'OCR+LLM' ? 'bg-white shadow-md text-blue-600' : 'text-slate-500 hover:bg-slate-200'}`}
                >
                  <Search size={14} />
                  <span className="text-[10px] font-bold">PIPE B (OCR)</span>
                </button>
              </div>
            </section>

            {settings.mode === 'VLM' ? (
              <section className="space-y-4">
                <div className="flex items-center gap-2 px-1">
                  <ImageIcon size={12} className="text-blue-500" />
                  <h2 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Visual AI Config (VL)</h2>
                </div>
                <div className="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-5">
                   <div className="space-y-1.5">
                     <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider">API Provider</label>
                     <select
                      value={settings.vlmProvider}
                      onChange={(e) => setSettings({...settings, vlmProvider: e.target.value})}
                      className="w-full text-sm border-slate-200 rounded-xl p-2.5 bg-slate-50/50 font-bold focus:ring-2 ring-blue-500/20"
                     >
                       <option value="ollama">Ollama (Local)</option>
                       <option value="openai">OpenAI (GPT-4o)</option>
                       <option value="anthropic">Anthropic (Claude 3.5)</option>
                       <option value="custom">Custom Endpoint</option>
                     </select>
                   </div>
                   <div className="space-y-1.5">
                     <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider">Base URL</label>
                     <input
                      type="text"
                      value={settings.vlmBaseUrl}
                      onChange={(e) => setSettings({...settings, vlmBaseUrl: e.target.value})}
                      className="w-full text-xs border-slate-200 rounded-xl p-2.5 bg-slate-50/50 font-mono text-slate-500"
                     />
                   </div>
                   <div className="space-y-1.5">
                     <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider">Model Name</label>
                     <input
                      type="text"
                      value={settings.vlmModel}
                      onChange={(e) => setSettings({...settings, vlmModel: e.target.value})}
                      placeholder="e.g. qwen2-vl:7b"
                      className="w-full text-sm border-slate-200 rounded-xl p-2.5 font-bold"
                     />
                   </div>
                   <div className="space-y-1.5">
                     <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider flex justify-between">
                       <span>API Key</span>
                       <Key size={10} />
                     </label>
                     <input
                      type="password"
                      value={settings.vlmApiKey}
                      onChange={(e) => setSettings({...settings, vlmApiKey: e.target.value})}
                      placeholder="sk-..."
                      className="w-full text-sm border-slate-200 rounded-xl p-2.5"
                     />
                   </div>
                   <div className="space-y-1.5">
                     <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider">Translate Prompt</label>
                     <textarea
                      value={settings.vlmTranslatePrompt}
                      onChange={(e) => setSettings({...settings, vlmTranslatePrompt: e.target.value})}
                      className="w-full text-xs border-slate-200 rounded-xl p-2.5 bg-slate-50/50 resize-none"
                      rows={3}
                      placeholder="Prompt for translation..."
                     />
                   </div>
                   <div className="space-y-1.5">
                     <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider">Explain Prompt</label>
                     <textarea
                      value={settings.vlmExplainPrompt}
                      onChange={(e) => setSettings({...settings, vlmExplainPrompt: e.target.value})}
                      className="w-full text-xs border-slate-200 rounded-xl p-2.5 bg-slate-50/50 resize-none"
                      rows={3}
                      placeholder="Prompt for explanation..."
                     />
                   </div>
                </div>
              </section>
            ) : (
              <section className="space-y-4">
                <div className="flex items-center gap-2 px-1">
                  <Server size={12} className="text-blue-500" />
                  <h2 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Modular Pipe B</h2>
                </div>
                <div className="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-6">
                   <div className="space-y-3">
                     <p className="text-[10px] font-black text-blue-600 bg-blue-50 px-2 py-1 rounded inline-block">1. OCR ENGINE</p>
                     <div className="space-y-2">
                        <select
                          value={settings.ocrProvider}
                          onChange={(e) => setSettings({...settings, ocrProvider: e.target.value})}
                          className="w-full text-xs border rounded-xl p-2 font-bold"
                        >
                          <option value="local">Tesseract (Local)</option>
                          <option value="ollama">Ollama (VL Based)</option>
                          <option value="baidu">Baidu Cloud</option>
                          <option value="google">Google Vision</option>
                          <option value="custom">Custom (Vision)</option>
                        </select>
                        <div className="grid grid-cols-2 gap-2">
                          <input
                            type="text"
                            value={settings.ocrBaseUrl}
                            onChange={(e) => setSettings({...settings, ocrBaseUrl: e.target.value})}
                            placeholder="Base URL"
                            className="text-[10px] border rounded-lg p-2 font-mono"
                          />
                          <input
                            type="text"
                            value={settings.ocrModel}
                            onChange={(e) => setSettings({...settings, ocrModel: e.target.value})}
                            placeholder="OCR Model"
                            className="text-[10px] border rounded-lg p-2 font-bold"
                          />
                        </div>
                        <input
                          type="password"
                          value={settings.ocrApiKey}
                          onChange={(e) => setSettings({...settings, ocrApiKey: e.target.value})}
                          placeholder="OCR API Key (if needed)"
                          className="w-full text-xs border rounded-xl p-2"
                        />
                     </div>
                   </div>

                   <div className="space-y-3 border-t pt-4">
                     <p className="text-[10px] font-black text-purple-600 bg-purple-50 px-2 py-1 rounded inline-block">2. LANGUAGE MODEL</p>
                     <div className="space-y-2">
                        <select
                          value={settings.llmProvider}
                          onChange={(e) => setSettings({...settings, llmProvider: e.target.value})}
                          className="w-full text-xs border rounded-xl p-2 font-bold"
                        >
                          <option value="ollama">Ollama (Local)</option>
                          <option value="openai">OpenAI</option>
                          <option value="anthropic">Anthropic</option>
                          <option value="custom">Custom Endpoint</option>
                        </select>
                        <input
                          type="text"
                          value={settings.llmBaseUrl}
                          onChange={(e) => setSettings({...settings, llmBaseUrl: e.target.value})}
                          placeholder="LLM Base URL"
                          className="w-full text-[10px] border rounded-lg p-2 font-mono"
                        />
                        <div className="grid grid-cols-2 gap-2">
                          <input
                            type="text"
                            value={settings.llmModel}
                            onChange={(e) => setSettings({...settings, llmModel: e.target.value})}
                            placeholder="Model Name (e.g. qwen2)"
                            className="text-[10px] border rounded-lg p-2 font-bold"
                          />
                          <input
                            type="password"
                            value={settings.llmApiKey}
                            onChange={(e) => setSettings({...settings, llmApiKey: e.target.value})}
                            placeholder="API Key"
                            className="text-[10px] border rounded-lg p-2"
                          />
                        </div>
                     </div>
                   </div>
                </div>
              </section>
            )}

            <section className="space-y-3">
              <div className="flex items-center gap-2 px-1">
                <Zap size={12} className="text-amber-500" />
                <h2 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Features</h2>
              </div>
              <div className="bg-slate-200/50 p-3 rounded-xl border border-slate-200/50 space-y-3">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs font-bold text-slate-700">划词翻译</p>
                      <p className="text-[10px] text-slate-500">选中文本后自动翻译</p>
                  </div>
                  <button
                    onClick={() => setSettings({...settings, enableTextSelection: !settings.enableTextSelection})}
                    className={`w-12 h-6 rounded-full transition-all ${settings.enableTextSelection ? 'bg-blue-600' : 'bg-slate-300'}`}
                  >
                    <div className={`w-5 h-5 bg-white rounded-full shadow-md transition-all ${settings.enableTextSelection ? 'translate-x-6' : 'translate-x-0.5'}`} />
                  </button>
                </div>
              </div>
            </section>

            <button
              onClick={handleSaveSettings}
              disabled={saveStatus !== 'idle'}
              className="w-full py-4 bg-slate-900 text-white rounded-2xl text-xs font-black hover:bg-slate-800 transition-all flex items-center justify-center gap-2 shadow-xl shadow-slate-200 active:scale-95 disabled:opacity-50 tracking-widest"
            >
              {saveStatus === 'idle' ? <Save size={14} /> : saveStatus === 'saving' ? <div className="w-3 h-3 border-2 border-white/30 border-t-white rounded-full animate-spin"></div> : <CheckCircle size={14} />}
              {saveStatus === 'idle' ? 'COMMIT ARCHITECTURE' : saveStatus === 'saving' ? 'SYNCHRONIZING...' : 'ARCHITECTURE DEPLOYED'}
            </button>
          </div>
        )}
      </main>

      <footer className="h-10 border-t bg-white flex items-center justify-center shrink-0">
        <div className="flex gap-4 items-center opacity-30 grayscale pointer-events-none">
           <Cpu size={12} />
           <Globe size={12} />
           <Key size={12} />
        </div>
      </footer>
    </div>
  )
}

export default App
