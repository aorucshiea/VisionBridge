import React, { useState, useEffect, useCallback, useRef } from 'react'
import { Settings, Image as ImageIcon, MessageSquare, Save, CheckCircle, Languages, Cpu, Search, Globe, Key, Activity, Server, Minus, Square, X as CloseIcon, Zap, Palette, ChevronDown, ChevronRight, Sparkles, Eye, EyeOff } from 'lucide-react'
import ScreenshotMask from './components/ScreenshotMask'
import ResultView from './components/ResultView'
import axios from 'axios'

// Helper function to convert hex to rgba
const hexToRgba = (hex: string, alpha: number): string => {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)
  return `rgba(${r}, ${g}, ${b}, ${alpha})`
}

