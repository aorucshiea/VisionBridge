{
  "name": "vision-bridge",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "author": "Vision Bridge Team",
  "description": "Intelligent Desktop Translator with AI Pipelines",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:optimized": "tsc && vite build && electron-builder && node scripts/optimize-dist.js",
    "build:web": "vite build",
    "preview": "vite preview",
    "shots": "electron scripts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.visionbridge.app",
    "productName": "Vision Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/tray-icon*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/selection-hook/**"
    ],
    "compression": "maximum",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/tray-icon.png",
      "category": "Utility",
      "maintainer": "Vision Bridge Team"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName} ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vision Bridge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@cordisjs/core": "^3.18.1",
    "lucide-react": "^0.284.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "selection-hook": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.16",
    "axios": "^1.5.0",
    "electron": "^26.6.10",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.9",
    "vite-plugin-electron": "^0.14.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
